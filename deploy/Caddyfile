# /etc/caddy/Caddyfile (setup-server.ps1 이 설치함)
# 도메인 사이트는 Caddy 가 HTTPS 인증서를 자동 발급·갱신합니다.

# React SPA 정적 파일 (인자: 배포 폴더)
(spa) {
	root * {args[0]}

	# Vite 빌드 결과물은 파일명에 해시가 붙으니 오래 캐시
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# 그 외(index.html 등)는 항상 새로 받아서 배포 즉시 반영
	@other not path /assets/*
	header @other Cache-Control "no-cache"

	# 없는 경로는 index.html 로 (클라이언트 라우팅)
	try_files {path} /index.html
	file_server
}

# 포트폴리오 (cloudheat.kr)
(site) {
	encode zstd gzip

	# 예전 데모 주소는 MES 웹으로
	@oldmes path /mes /mes/*
	redir @oldmes https://mes.__DOMAIN__/ 302

	import spa /var/www/__APP__/current
}

# MES 웹 (mes.cloudheat.kr): 화면 + /api → ASP.NET Core
(mes) {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:5080
	}
	handle {
		import spa /var/www/__APP__-mes/current
	}
}

# 가상 ERP 화면 (erp.cloudheat.kr): 화면 + /erp/ui → 가상 ERP 서버
# MES 연동 API(/erp/v1)는 밖으로 열지 않음 (서버 내부 127.0.0.1 로만 MES 가 호출)
(erp) {
	encode zstd gzip

	handle /erp/ui/* {
		reverse_proxy 127.0.0.1:5090
	}
	handle /erp/* {
		respond "Not Found" 404
	}
	handle {
		import spa /var/www/__APP__-erp-web/current
	}
}

__DOMAIN__ {
	import site
}

www.__DOMAIN__ {
	redir https://__DOMAIN__{uri} permanent
}

erp.__DOMAIN__ {
	import erp
}

mes.__DOMAIN__ {
	import mes
}

# 내부망 확인용: http://192.168.0.10 (포트폴리오), :8080 (MES), :8090 (가상 ERP 화면)
:80 {
	import site
}

:8080 {
	import mes
}

:8090 {
	import erp
}
